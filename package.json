{
  "name": "distributed-job-queue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A distributed job queue built from first principles for learning and demonstration.",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "start": "node --experimental-strip-types src/server.ts",
    "test": "node --test --experimental-strip-types test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "redis": "^6.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
